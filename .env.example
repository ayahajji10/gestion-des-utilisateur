# ==============================================================================
# Configuration des variables d'environnement - Exécution Windows Locale (Sans Docker)
# Copiez ce fichier sous le nom .env pour vos surcharges personnalisées si nécessaire
# ==============================================================================

# -----------------
# 1. Base de Données PostgreSQL
# -----------------
# Port standard: 5432 (ou 5433 si votre service Windows écoute sur 5433)
POSTGRES_PORT=5433
POSTGRES_DB=user_management_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/user_management_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# -----------------
# 2. Keycloak (SSO / IAM)
# -----------------
# Port d'écoute Keycloak sur Windows (par défaut 8080)
KEYCLOAK_PORT=8080
KEYCLOAK_AUTH_SERVER_URL=http://localhost:8080
KEYCLOAK_REALM=user-management-realm
KEYCLOAK_CLIENT_ID=user-management-backend
KEYCLOAK_CLIENT_SECRET=backend-secret-key-for-dev
KEYCLOAK_ISSUER_URI=http://localhost:8080/realms/user-management-realm
KEYCLOAK_JWK_SET_URI=http://localhost:8080/realms/user-management-realm/protocol/openid-connect/certs

# Identifiants de l'administrateur de la console Keycloak
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# -----------------
# 3. Backend Spring Boot
# -----------------
BACKEND_PORT=8081
SPRING_PROFILES_ACTIVE=local
ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# -----------------
# 4. Frontend Angular
# -----------------
FRONTEND_PORT=4200
